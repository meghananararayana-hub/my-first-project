<body>

    <div class="login-box">

        <h2>Welcome Back!</h2>
        <p>Login to your account</p>

        <form>
            <input type="email"
                   placeholder="Email address" required>

            <input type="password"
                   placeholder="Password" required>

            <button type="submit">Login</button>
        </form>

        <a href="#">Forgot Password?</a>
        <a href="#">Create Account</a>

    </div>

</body>
